# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe 결제
# 미설정 시 결제 기능 비활성화 (503) — 빌드는 통과
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# 앱 URL (Stripe success/cancel 리다이렉트용)
NEXT_PUBLIC_APP_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Email (Resend)
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry 에러 모니터링
# DSN 없으면 Sentry 자동 비활성
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics 4
# GA_ID 없으면 GA 자동 비활성
NEXT_PUBLIC_GA_ID=

# Upstash Redis rate limit (미설정 시 in-memory fallback 자동 사용)
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel (자동 주입 — 로컬 개발 시 수동 설정 가능)
NEXT_PUBLIC_VERCEL_ENV=development
