# ───── Required (없으면 빌드/런타임 실패) ─────

## Supabase (DB/Auth/Storage)
NEXT_PUBLIC_SUPABASE_URL=          # https://{ref}.supabase.co — Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # anon public key — 위와 동일 위치
SUPABASE_SERVICE_ROLE_KEY=         # service_role key (sensitive!) — 동일 위치, "Reveal" 클릭

## Stripe (결제)
STRIPE_SECRET_KEY=                 # sk_live_... — Stripe Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=             # whsec_... — Webhook endpoint 등록 후 Signing secret

## Resend (이메일)
RESEND_API_KEY=                    # re_... — Resend Dashboard → API Keys
RESEND_FROM=onboarding@resend.dev  # 발송 주소 (prod: noreply@yourdomain.com)

## LiveKit (영상)
LIVEKIT_URL=                       # wss://...livekit.cloud — LiveKit Cloud project
LIVEKIT_API_KEY=                   # LiveKit project API key
LIVEKIT_API_SECRET=                # LiveKit project API secret

## Sentry (에러 모니터링) — 옵션이지만 prod 필수
NEXT_PUBLIC_SENTRY_DSN=            # https://...@sentry.io/... — Sentry Project Settings
SENTRY_ORG=                        # Sentry org slug
SENTRY_PROJECT=                    # Sentry project slug
SENTRY_AUTH_TOKEN=                 # source map 업로드용 (CI에서 사용)

# ───── Recommended (없어도 동작하나 prod 강력 권장) ─────

## Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=            # Upstash console
UPSTASH_REDIS_REST_TOKEN=          # 동일

## Google Analytics
NEXT_PUBLIC_GA_ID=                 # G-XXXXXXXXXX — GA4 측정 ID

## Web Push (브라우저 알림)
VAPID_PRIVATE_KEY=                 # bun run scripts/generate-vapid.ts 로 발급
NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # 위 스크립트 출력
VAPID_SUBJECT=                     # mailto:admin@yourdomain.com

# ───── Optional ─────

## AI 이미지 생성 (nano-banana, enabler 아바타)
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey

## 운영자 알림
ADMIN_EMAIL=                       # 신규 신청/문의 시 알림 받을 이메일
PAYMENT_SETUP_RECIPIENT=           # 결제 셋업 폼 받을 이메일

## 보안 시크릿 (자동 발급 가능 — bun -e "console.log(crypto.randomUUID())")
CRON_SECRET=                       # Vercel cron 인증
IMPERSONATION_SECRET=              # admin impersonation 토큰
UNSUBSCRIBE_SECRET=                # 이메일 unsubscribe 링크 서명

## 사이트 메타
NEXT_PUBLIC_APP_URL=https://yourdomain.com   # OG/이메일 절대경로용
NEXT_PUBLIC_VERCEL_ENV=             # production/preview/development (Vercel 자동)

## 테스트/개발
NEXT_PUBLIC_SHOW_TEST_DATA=false    # true면 TestLoginPanel 표시 (prod에서 false 필수!)

## Launch Dashboard
LAUNCH_DASHBOARD_ALLOWED_EMAILS=    # 콤마 구분 이메일 목록. 없으면 fallback (luke,woosub,sson @xrx.studio)
